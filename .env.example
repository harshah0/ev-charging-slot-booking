# Example environment variables for production
# Copy to .env (do NOT commit secrets to version control)

SECRET_KEY=change-me-with-secure-random-value
DATABASE_URL=postgresql://username:password@hostname:5432/dbname
FLASK_ENV=production
SESSION_LIFETIME_DAYS=7
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
USE_WHITENOISE=true
# Optional: tune SQLAlchemy pool
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20

# OpenChargeMap public station discovery
OPENCHARGEMAP_ENABLED=true
OPENCHARGEMAP_API_KEY=replace-with-openchargemap-api-key
OPENCHARGEMAP_ENDPOINT=https://api.openchargemap.io/v3/poi/
OPENCHARGEMAP_TIMEOUT_SECONDS=6
OPENCHARGEMAP_CACHE_TTL_SECONDS=300
OPENCHARGEMAP_MAX_RESULTS=25
OPENCHARGEMAP_RETRY_ATTEMPTS=2
OPENCHARGEMAP_RETRY_BACKOFF_SECONDS=0.35
OPENCHARGEMAP_RATE_LIMIT_COOLDOWN_SECONDS=60
OPENCHARGEMAP_CACHE_MAX_ENTRIES=500
# Optional: shared Redis to cache OpenChargeMap responses and share rate-limit state
OPENCHARGEMAP_REDIS_URL=
OPENCHARGEMAP_REDIS_PREFIX=ocm:

# For Render or Heroku, the platform typically provides DATABASE_URL and PORT
